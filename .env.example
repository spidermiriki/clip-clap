# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne JAMAIS commiter .env — il est dans .gitignore.

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Activer le mock de l'API creators en développement (désactivé en prod par défaut).
# Copier dans frontend/.env.development.local et mettre à true pour développer
# sans le backend. Retirer quand le contrôleur /api/creators/me sera disponible (#70).
# VITE_USE_MOCK=true

# ── Zitadel (fournisseur d'identité) ─────────────────────────────────────────
# URL de votre instance Zitadel (ex. https://clicclap.zitadel.cloud)
ZITADEL_ISSUER=https://<instance>.zitadel.cloud

# ── Zitadel — API de gestion (attribution des rôles client/créateur, issue #11) ──────────────
# Jeton d'accès personnel (PAT) d'un compte de service Zitadel ayant la permission user.grant.write
ZITADEL_SERVICE_TOKEN=<pat-du-compte-de-service>
# Identifiant de l'organisation Zitadel (console Zitadel > Organisation > Détails)
ZITADEL_ORG_ID=<id-de-l-organisation>

# ── Cloudinary (stockage des médias) ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
