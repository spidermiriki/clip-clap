# Facultatif : copier en .env.local pour utiliser une autre instance Zitadel.
# Sans ce fichier, les valeurs par défaut de src/auth/oidcConfig.js sont utilisées.
# Ces valeurs ne sont pas secrètes (application PKCE, sans client secret).
VITE_ZITADEL_ISSUER=https://<instance>.zitadel.cloud
VITE_ZITADEL_CLIENT_ID=<client-id-de-l-application-clicclap-web>
VITE_ZITADEL_PROJECT_ID=<id-du-projet-clic-clap>

# URL du backend, sans slash final (#106). Vide ou absente en dev : les appels à /api passent
# par le proxy Vite (vite.config.js). En production (Vercel), l'URL du service Render, ex. :
# VITE_API_BASE_URL=https://<service>.onrender.com
# Figée au build : après un changement sur Vercel, il faut redéployer.
